# ============================================================================
# CEDEM · Variables de entorno — PLANTILLA
#
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` está ignorado por git: las llaves NUNCA se suben al repositorio.
#
# Las tres primeras se obtienen en Supabase:
#   Panel del proyecto → Project Settings → API
#   · Project URL            → NEXT_PUBLIC_SUPABASE_URL
#   · anon / publishable key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   · service_role key       → SUPABASE_SERVICE_ROLE_KEY   (¡SECRETA!)
#
# La cuarta, en Project Settings → Database → Connection string → URI
# (sustituye [YOUR-PASSWORD] por la contraseña que definiste al crear el proyecto)
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cadena directa a Postgres. Se usa para aplicar las migraciones del esquema.
# Formato: postgresql://postgres:TU_PASSWORD@db.TU_REF.supabase.co:5432/postgres
DATABASE_URL=

# --- Sitio ------------------------------------------------------------------
# URL pública del sitio. En producción será https://www.cedem.com.mx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (Fase 4 · Camino del Dueño) ----------------------------------------
# Se puede dejar vacío hasta que se aborde esa fase.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELO_LECTURA=deepseek-v4-pro
DEEPSEEK_MODELO_AGENTE=deepseek-flash

# --- Pagos (Stripe) ---------------------------------------------------------
# Déjalas vacías hasta tener la cuenta. Sin llaves, la plataforma funciona igual:
# la membresía se pide por transferencia y el equipo la activa a mano.
#   Panel de Stripe → Developers → API keys
#     · Publishable key → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#     · Secret key      → STRIPE_SECRET_KEY            (¡SECRETA!)
#   Panel de Stripe → Developers → Webhooks → Add endpoint
#     · URL: https://TU-DOMINIO/api/webhooks/stripe
#     · Eventos: checkout.session.completed, charge.refunded
#     · Signing secret → STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Correo (Google Workspace) ---------------------------------------------
# CEDEM ya usa Google para su correo, así que no hace falta contratar nada: se usa
# el servidor de Google con una "contraseña de aplicación" de una cuenta del
# dominio. Los pasos completos, en docs/18-correo-de-cedem.md
#
# Sin estas variables la plataforma funciona igual: los correos se guardan en la
# cola (Administración → Correos) para mandarlos a mano.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CEDEM · Centro de Dueñez Empresaria <circulo@cedem.com.mx>"
